# Copiar a .env y rellenar. El .env real NUNCA se versiona.

# Cadena de conexion de Neon.
# Se copia de console.neon.tech > proyecto > Connection string.
# Usar la variante "pooled" para la API y la "direct" para migraciones;
# si solo aparece una, sirve igual.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Claves de las fuentes externas (todavia no se usan).
TMDB_API_KEY=
