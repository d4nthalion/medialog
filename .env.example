# Copiar a .env y rellenar. El .env real NUNCA se versiona.
#
# Todo esto sale del mismo sitio: console.neon.tech > proyecto >
# Connection string. Neon da una URL con este formato:
#
#   postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require
#
# De ahi se sacan las cuatro variables de abajo.


# --- Migraciones (db/tools/run.mjs) ------------------------------------
# La cadena tal cual la da Neon, sin tocar.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require


# --- API (Spring Boot) -------------------------------------------------
# Misma conexion, pero en formato JDBC y con las credenciales aparte.
#
# Se separan a proposito: el driver JDBC de PostgreSQL no admite
# usuario:clave@host, y ademas las claves de Neon llevan simbolos que
# romperian la URL al interpretarse.
#
# Del HOST se quita el sufijo "-pooler" si lo lleva: HikariCP ya hace
# pooling por su cuenta, y el pooler de Neon esta pensado para entornos
# serverless sin pool propio.
JDBC_DATABASE_URL=jdbc:postgresql://HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=USUARIO
DB_PASSWORD=CLAVE


# --- Fuentes externas (todavia no se usan) -----------------------------
TMDB_API_KEY=
